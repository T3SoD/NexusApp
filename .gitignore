.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / VS Code
.idea/
.vscode/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/
*.publishsettings

# Installer build output
Output/
*.exe
*.msi

# OS files
.DS_Store
Thumbs.db

# Local-only dev/deploy tooling (contain local paths / not part of the app)
compare_nexus_data.py
deploy_nexus.ps1

# Python bytecode cache
__pycache__/
*.pyc

