<Window x:Class="NexusApp.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NexusApp.Converters"
        xmlns:views="clr-namespace:NexusApp.Views"
        Title="Nexus Overlay"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Width="320" Height="480"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:TierColorConverter x:Key="TierColor"/>
        <conv:RarityColorConverter x:Key="RarityColor"/>
        <conv:HexColorConverter x:Key="HexColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <!-- ── Floating HUD panel: MOBIGLAS chamfered shell (TL + BR bevel, like the mock's clip-path).
         FramePath draws the bevelled fill + 1px slate border; ContentRoot is clipped to the same
         silhouette so inner content can't poke past the bevel. Both geometries recompute on resize
         in code-behind (UpdateChamfer). ── -->
    <Grid x:Name="RootScale">
      <!-- ── PanelHost: the normal-mode overlay panel (frame + content). In ghost mode
           (issue #27) it is the sliding panel that opens beside the rail, so it carries the
           TranslateTransform the slide animates and a Margin the window sets to leave room
           for the rail. Normal mode never touches either. ── -->
      <Grid x:Name="PanelHost" Opacity="1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelSlide"/>
        </Grid.RenderTransform>
        <Path x:Name="FramePath" StrokeThickness="1" SnapsToDevicePixels="True"
              Stroke="{DynamicResource BorderBrush}">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource OverlayBgTopColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource OverlayBgBotColor}" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>
        <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="HistorySplitterRow" Height="8" MinHeight="8"/>
                <RowDefinition x:Name="HistoryStripRow" Height="120" MinHeight="50"/>
            </Grid.RowDefinitions>

            <!-- ── Header: drag zone + opacity + close ── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            HorizontalAlignment="Stretch" Background="Transparent"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <!-- Animated Nexus mark (beam + sparks), replacing the old spinning arc. -->
                    <views:NexusBeamIcon Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="NEXUS" Foreground="{DynamicResource AccentBrush}"
                               FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="OVERLAY" Foreground="{DynamicResource FgDimBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="8" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="7,3,0,0"/>
                </StackPanel>
                <!-- Window opacity - shared across every tab -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                            PreviewMouseWheel="OpacityRow_MouseWheel">
                    <!-- ValueChanged is wired in code AFTER the ctor restores the saved opacity:
                         a XAML-wired handler fires during InitializeComponent (Minimum coerces the
                         default Value 0 up to 0.2) and would persist that transient over the saved
                         setting before the restore can read it. -->
                    <Slider x:Name="OpacitySlider" Style="{DynamicResource HudSlider}"
                            Minimum="0.2" Maximum="1.0" SmallChange="0.05"
                            Width="74" VerticalAlignment="Center" Margin="0,0,6,0"
                            ToolTip="Overlay opacity"/>
                    <TextBlock x:Name="OpacityLabel" Text="100%"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9" Foreground="{DynamicResource FgDimBrush}"
                               VerticalAlignment="Center" Width="30"/>
                </StackPanel>
                <!-- Quick settings: opens the same GhostFlyoutHost the ghost rail's gear uses, so
                     click-through and rail size are reachable in normal mode too (issue #27 review). -->
                <Button x:Name="QuickSettingsBtn" Grid.Column="2" Style="{StaticResource NexusButton}"
                        Width="26" Height="26" Padding="0" VerticalAlignment="Center"
                        Margin="0,0,4,0" Click="QuickSettings_Click"/>
                <Button x:Name="CloseBtn" Grid.Column="3" Content="✕" Style="{StaticResource NexusButton}"
                        Width="26" Height="26" Padding="0" FontSize="11" VerticalAlignment="Center"
                        Margin="0,0,8,0" Click="Close_Click"/>
                <!-- accent hairline under header -->
                <Border Grid.ColumnSpan="4" VerticalAlignment="Bottom" Height="1" Margin="12,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource AccentClearColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0.5"/>
                            <GradientStop Color="{DynamicResource AccentClearColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- ── Tab strip: Active Pill (mock: nexus-design-lab/overlay-redesign concept 02).
                 Icons are the app's dock glyphs via TabGlyphSpecs; active tab expands into a
                 chamfered amber icon+label pill; counts ride the icon corner as chips. ── -->
            <views:OverlayTabStrip x:Name="TabStrip" Grid.Row="1" Margin="0,2,0,0"/>

            <!-- Ghost mode (issue #27) section eyebrow: takes the tab strip's row when the rail
                 is the nav, so the open panel still names the section it is showing. Set in code
                 from OverlayTabs.LabelFor; collapsed (and the strip visible) in normal mode. -->
            <TextBlock x:Name="GhostEyebrow" Grid.Row="1" Visibility="Collapsed" FontSize="8.5"
                       Foreground="{DynamicResource AccentBrush}" Opacity="0.85"
                       Margin="12,8,0,4" VerticalAlignment="Bottom"/>

            <!-- ── Tab content ── -->
            <Grid Grid.Row="2">

                <!-- HUB tab (Beta Game.log session): MOBIGLAS glance. Mock order = SCAN STATUS LEDs,
                     hero tiles (READY ORDERS + HAUL, accent chamfer), SERVER / SHARD (chamfer),
                     COLLECTION LOG. One vertical scroll, like the mock's .body. The pills / status line /
                     footer the old layout carried are gone: session-monitoring shows via the LEDs, and
                     Reset session / advanced monitor now live in the advanced Game.log monitor. -->
                <ScrollViewer x:Name="StatsTabContent" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10,12,12">

                        <!-- SCAN STATUS: read-only LED pills (green on / yellow paused / red off),
                             synced from the SCAN + HAULING toggles (built in BuildHubScanControls). -->
                        <TextBlock Text="SCAN STATUS" Style="{StaticResource SectionLabel}" Margin="1,0,0,6"/>
                        <WrapPanel x:Name="HubScanBar"/>

                        <!-- F1 hero tiles (frozen 2026-07-11 overlay pass): 2-column grid, 8px gap, each tile
                             the same accent ChamferPanel look (amber-line border + amber glow) the old single
                             BLUEPRINTS COLLECTED hero used. READY ORDERS = work orders ready to collect (cyan
                             when > 0, else dim); HAUL = total committed SCU across active hauls (always cyan)
                             + delivered x/y drops sub-line. Values are set in code-behind (RebuildStatsPanel);
                             the old count-up moved into the COLLECTION LOG header below as "(N)". -->
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <views:ChamferPanel Grid.Column="0" Accent="True" ShowBrackets="True" Chamfer="12"
                                                Padding="10,11">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="HubReadyValue" Text="0"
                                               FontFamily="{StaticResource MonoFont}" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource FgDimBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="READY ORDERS" FontSize="8.5" FontWeight="Bold"
                                               Foreground="{DynamicResource FgDimBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </views:ChamferPanel>
                            <views:ChamferPanel Grid.Column="2" Accent="True" ShowBrackets="True" Chamfer="12"
                                                Padding="10,11">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="HubHaulValue" Text="0 SCU"
                                               FontFamily="{StaticResource MonoFont}" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource CyanBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="HAUL" FontSize="8.5" FontWeight="Bold"
                                               Foreground="{DynamicResource FgDimBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="HubHaulSub" Text="0/0 drops"
                                               FontFamily="{StaticResource MonoFont}" FontSize="10"
                                               Foreground="{DynamicResource FgDimBrush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </views:ChamferPanel>
                        </Grid>

                        <!-- SERVER / SHARD: current + recent shards (built in code-behind, RebuildShardPanel). -->
                        <views:ChamferPanel Chamfer="12" Padding="13,10" Margin="0,11,0,0">
                            <StackPanel x:Name="ShardPanel"/>
                        </views:ChamferPanel>

                        <!-- COLLECTION LOG: blueprint feed (newest first), inline in the scroll. Header count
                             is the same App.GameLog.Count the old hero count-up rendered (F2, frozen). -->
                        <TextBlock x:Name="StatsFeedHeader" Text="COLLECTION LOG (0)" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="1,13,0,4"/>
                        <Grid MinHeight="56">
                            <StackPanel x:Name="StatsFeedItems"/>
                            <TextBlock x:Name="StatsEmptyState"
                                       Text="No blueprints yet this session.&#x0a;Unlock one in-game and it appears here."
                                       FontSize="10" Foreground="{DynamicResource FgDimBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- SCAN tab -->
                <Grid x:Name="ScanTabContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Scan controls: Auto-scan / Scan box toggle switches (built in code-behind to
                         match the STATS tab) + a Set RS detection region link. -->
                    <StackPanel Grid.Row="0" Margin="10,10,10,2">
                        <WrapPanel x:Name="ScanControlBar"/>
                        <TextBlock x:Name="SetRegionBtn" Text="⊕  Set RS detection region" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                                   Background="Transparent" Padding="2,3,2,2"
                                   HorizontalAlignment="Left" MouseLeftButtonUp="SetRegion_Click"/>
                    </StackPanel>

                    <!-- Scan status chip (chamfered) -->
                    <views:ChamferPanel Grid.Row="1" HorizontalAlignment="Left" Margin="10,8,10,0"
                                        Chamfer="7" Padding="10,3">
                        <TextBlock x:Name="OverlayScanStatus"
                                   Text="◎  Scan off" FontSize="10"
                                   Foreground="{DynamicResource FgDimBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </views:ChamferPanel>

                    <!-- RS input -->
                    <Grid Grid.Row="2" Margin="10,8,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Sized down from the original 42/16 pair to sit with the overlay's
                             10-11px density (owner ruling 2026-07-27). Padding drops to 10,4
                             because the ChamferTextBox base carries 10,8: a 16.5px mono line at
                             12.5 plus 16px of padding would not fit a 30px row. -->
                        <TextBox x:Name="OverlayRsInput" Style="{StaticResource ChamferTextBox}"
                                 Height="30" FontSize="12.5" Padding="10,4" FontFamily="{StaticResource MonoFont}"
                                 KeyDown="OverlayRsInput_KeyDown"
                                 Tag="Enter RS value…"/>
                        <Button Grid.Column="1" Content="→" Style="{StaticResource ChamferAccentButton}"
                                Height="30" Margin="6,0,0,0" Padding="10,0" FontSize="13"
                                Click="OverlayScan_Click"/>
                    </Grid>

                    <!-- Results -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="10,0">
                        <ItemsControl x:Name="OverlayResults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:ChamferPanel Margin="0,3" Chamfer="9" ClipContent="True" Padding="0"
                                                        MouseLeftButtonDown="Card_MouseLeftButtonDown">
                                        <views:ChamferPanel.Style>
                                            <Style TargetType="{x:Type views:ChamferPanel}" BasedOn="{StaticResource {x:Type views:ChamferPanel}}">
                                                <Setter Property="Background"    Value="{DynamicResource Bg3Brush}"/>
                                                <Setter Property="BorderBrush"   Value="{DynamicResource BorderBrush}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HighlightBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsInCart}" Value="True">
                                                        <Setter Property="Background"  Value="{DynamicResource AccentTintBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:ChamferPanel.Style>
                                        <Grid>
                                            <Border Width="3" HorizontalAlignment="Left"
                                                    Background="{Binding CardColor, Converter={StaticResource HexColor}}"/>
                                            <StackPanel Margin="11,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Resource.Name}" FontWeight="SemiBold"
                                                                   Foreground="{Binding Resource.Rarity, Converter={StaticResource RarityColor}}"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- C1: tier chip (S = amber-bright text+border; A/B/C = dim) -->
                                                        <Border Padding="5,1" CornerRadius="3" Margin="5,0,0,0"
                                                                VerticalAlignment="Center" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource NavBorderBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Resource.Tier}" Value="S">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Resource.Tier}"
                                                                       FontFamily="{StaticResource MonoFont}" FontSize="9">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Resource.Tier}" Value="S">
                                                                                <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Padding="3,1" CornerRadius="3" Margin="5,0,0,0"
                                                                Background="{DynamicResource AccentBrush}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsInCart, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="CART" FontSize="8" FontWeight="Bold"
                                                                       Foreground="{DynamicResource OnAccentBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Padding="4,2" CornerRadius="3" Margin="0,0,6,0"
                                                                Background="{DynamicResource HighlightBrush}">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding CardColor, Converter={StaticResource HexColor}}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Resource.BaseRs, StringFormat='RS {0:N0}'}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11" Foreground="{DynamicResource CyanBrush}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding NodesText}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="11" Foreground="{DynamicResource FgDimBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- C2: refinery guidance line, its own row (Task 7 slots a composition
                                                         bar beneath this without touching the rows above). Frozen format
                                                         "Best refinery: <station> +<pct>%" (G2); the +0;-0 numeric format
                                                         keeps the sign correct for negative modifiers (renders -8%, never
                                                         +-8%). Collapses when the resource has no refinery data at all. -->
                                                    <TextBlock FontSize="10.5"
                                                               Foreground="{DynamicResource FgDimBrush}" Margin="0,3,0,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="Best refinery: {0} {1:+0;-0}%">
                                                                <Binding Path="BestRefinery.Station"/>
                                                                <Binding Path="BestRefinery.ModifierPct"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BestRefinery}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Live refined sell line (market data, amendment 2026-07-27
                                                         item 5). Built in code-behind (MarketSellHost_Loaded) because
                                                         the value comes from the runtime UEX snapshot rather than the
                                                         item, same host idiom as CompositionHost below. Stays empty
                                                         (zero height, card unchanged) when market data is off, no
                                                         snapshot has landed, or the ore has no priced row. -->
                                                    <StackPanel x:Name="MarketSellHost" Loaded="MarketSellHost_Loaded"/>
                                                </StackPanel>
                                                <!-- C5: cart button (+ CART / IN CART, drives ToggleCartCommand) -->
                                                <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                        Cursor="Hand" FontSize="9" FontWeight="Bold"
                                                        FontFamily="{StaticResource MonoFont}"
                                                        Command="{Binding DataContext.ToggleCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Click="CartToggle_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="3" Padding="7,3">
                                                                            <TextBlock Text="{TemplateBinding Content}"
                                                                                       Foreground="{TemplateBinding Foreground}"
                                                                                       FontFamily="{TemplateBinding FontFamily}"
                                                                                       FontSize="{TemplateBinding FontSize}"
                                                                                       FontWeight="{TemplateBinding FontWeight}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Content" Value="+ CART"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource CyanDimBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource CyanStrongBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInCart}" Value="True">
                                                                    <Setter Property="Content" Value="IN CART"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnCyanBrush}"/>
                                                                    <Setter Property="Background" Value="{DynamicResource CyanBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                            <!-- Task 7 (C3/C4): deposit-composition bar + tap-to-expand rows,
                                                 built per card in code-behind (CompositionHost_Loaded) because
                                                 the segment/row count is per-resource dynamic. Empty for
                                                 no-composition ores, which then never toggle. -->
                                            <StackPanel x:Name="CompositionHost" Loaded="CompositionHost_Loaded"/>
                                            </StackPanel>
                                        </Grid>
                                    </views:ChamferPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ORDERS tab -->
                <Grid x:Name="OrdersTabContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="WorkOrderBtn" Grid.Row="0" Content="▤   Open Refinery Tracker"
                            Style="{StaticResource ChamferAccentButton}"
                            HorizontalAlignment="Stretch"
                            Padding="0,12" Margin="10,12,10,0"
                            Click="WorkOrderToggle_Click"/>

                    <!-- E2 quick-add: "+ Quick order" trigger + inline unfold form, built once in code-behind. -->
                    <StackPanel x:Name="QuickAddHost" Grid.Row="1" Margin="10,10,10,0"/>

                    <StackPanel x:Name="OrdersSummaryPanel" Grid.Row="2" Margin="10,14,10,0"/>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OrdersPanelItems" Margin="10,0"/>
                        </ScrollViewer>
                        <StackPanel x:Name="OrdersEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Visibility="Collapsed">
                            <views:ChamferPanel Width="46" Height="46" Chamfer="6"
                                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                                Padding="0" HorizontalAlignment="Center">
                                <TextBlock Text="▤" FontSize="20" Foreground="{DynamicResource FgDimBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </views:ChamferPanel>
                            <TextBlock Text="No active work orders" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource FgDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="Open the tracker to create one" FontSize="9"
                                       Foreground="{DynamicResource FgDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- SHOPPING tab -->
                <Grid x:Name="ShoppingTabContent" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,6">
                        <StackPanel x:Name="ShoppingPanelItems"/>
                    </ScrollViewer>
                </Grid>

                <!-- HAULING tab: contract scan controls (fixed) + active hauls + consolidation glance (App.Hauls) -->
                <Grid x:Name="HaulingTabContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Contract scan controls: Auto-scan contracts / Contract box toggle switches (built in
                         code-behind to match the SCAN tab) + a Set contract detection region link. Fixed area, OUTSIDE
                         HaulingList (which RebuildHaulingPanel clears). -->
                    <StackPanel Grid.Row="0" Margin="10,10,10,2">
                        <WrapPanel x:Name="HaulingControlBar"/>
                        <TextBlock x:Name="SetContractRegionBtn" Text="⊕  Set contract detection region" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                                   Background="Transparent" Padding="2,3,2,2"
                                   HorizontalAlignment="Left" MouseLeftButtonUp="SetContractRegion_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,8">
                        <StackPanel x:Name="HaulingList"/>
                    </ScrollViewer>
                </Grid>

                <!-- GUIDES tab: the Mission Guides catalog as a compact title list that hands the
                     tab body to the shared GuideViewer. Built in code on first entry (see the
                     GUIDES tab region in the code-behind) so nothing exists until it is opened. -->
                <Grid x:Name="GuidesTabContent" Visibility="Collapsed"/>
            </Grid>

            <!-- Drag handle to resize history strip: 8px hit target with a centered 1px hairline
                 (issue #27 review - the old 4px Background-only splitter was hard to grab). -->
            <GridSplitter x:Name="HistorySplitter" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Cursor="SizeNS" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource NavBorderBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- History strip (RECENT scans - hidden on the STATS tab; it's scan-only) -->
            <Border x:Name="HistoryStrip_Container" Grid.Row="4" Background="{DynamicResource NavBgBrush}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,6,8,4">
                        <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <Button Content="CLEAR" Style="{StaticResource NexusButton}"
                                HorizontalAlignment="Right"
                                Padding="6,2" FontSize="9"
                                Click="ClearHistory_Click"/>
                    </Grid>
                    <StackPanel x:Name="OverlayHistoryFilterPanel" DockPanel.Dock="Top"
                                Orientation="Horizontal" Margin="12,0,8,4"/>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource NavBorderBrush}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="6,4,6,4">
                        <StackPanel x:Name="HistoryStrip"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
      </Grid>

        <!-- ── Ghost mode (issue #27) chrome. Both are collapsed in normal mode and cost
             nothing there; the window sizes itself to rail-only, rail + panel, or rail +
             flyout and aligns these to the side the panel expands from. GhostFlyoutHost's
             content is built lazily in code the first time the gear is used. ── -->
        <views:OverlayGhostRail x:Name="GhostRail" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
        <Border x:Name="GhostFlyoutHost" Visibility="Collapsed" Width="230"
                VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
    </Grid>
</Window>
